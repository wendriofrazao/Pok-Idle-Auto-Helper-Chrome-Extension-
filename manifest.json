{
  "manifest_version": 3,
  "name": "PokéIdle Automação",
  "version": "1.2.4",
  "description": "Automação para o PokéIdle IO",

  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/app*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}