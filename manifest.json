{
  "manifest_version": 3,
  "name": "PokéIdle Automação",
  "version": "2.5.1",
  "description": "Automação para o PokéIdle",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PokéIdle Bot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/app*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}